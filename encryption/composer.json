{
    "name": "kodhe/codeigniter-encryption",
    "description": "Refactored Encryption Library for CodeIgniter 3 with PSR-4/PSR-12 compliance",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "codeigniter",
        "codeigniter3",
        "encryption",
        "openssl",
        "psr-4",
        "psr-12"
    ],
    "authors": [
        {
            "name": "Your Name",
            "email": "your.email@example.com"
        }
    ],
    "require": {
        "php": "^7.4|^8.0",
        "ext-openssl": "*",
        "ext-hash": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "Kodhe\\Encryption\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kodhe\\Encryption\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src -name '*.php' -exec php -l {} \\;"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
