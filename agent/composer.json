{
  "name": "kodhe/agent",
  "description": "Kodhe User Agent detection library - PSR-4 compatible with CodeIgniter 3 support",
  "type": "library",
  "version": "2.0.0",
  "license": "MIT",
  "keywords": [
    "user-agent",
    "codeigniter",
    "browser-detection",
    "mobile-detection",
    "psr-4"
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Kodhe\\Framework\\Agent\\": "src/"
    },
    "files": [
      "src/compat.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Kodhe\\Framework\\Agent\\Tests\\": "tests/"
    }
  }
}