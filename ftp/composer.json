{
  "name": "kodhe/ftp",
  "description": "Refactored FTP Library for CodeIgniter 3 with PSR-4 autoloading",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Your Name",
      "email": "your.email@example.com"
    }
  ],
  "require": {
    "php": "^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0"
  },
  "autoload": {
    "psr-4": {
      "Kodhe\\Framework\\Ftp\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kodhe\\Framework\\Ftp\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}