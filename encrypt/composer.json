{
  "name": "kodhe/ci3-encrypt",
  "description": "Modernized Encrypt Library for CodeIgniter 3 with OpenSSL support",
  "type": "library",
  "keywords": [
    "codeigniter",
    "ci3",
    "encrypt",
    "openssl",
    "security",
    "psr-4"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Your Name",
      "email": "your.email@example.com"
    }
  ],
  "require": {
    "php": "^7.0|^8.0",
    "ext-openssl": "*",
    "ext-hash": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0"
  },
  "autoload": {
    "psr-4": {
      "Kodhe\\Framework\\Encrypt\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kodhe\\Framework\\Encrypt\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-html coverage"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}