{
  "name": "kodhe/parser",
  "description": "Kodhe parser library - Modular CodeIgniter 3 Parser with PSR-4",
  "type": "library",
  "version": "2.0.0",
  "license": "MIT",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Kodhe\\Parser\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kodhe\\Parser\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
