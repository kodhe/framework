{
  "name": "kodhe/email",
  "description": "Modular Email Library for CodeIgniter 3 with PSR-4/PSR-12 compliance",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Kodhe\\Framework\\Email\\": "src/"
    },
    "files": [
      "src/compat.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Kodhe\\Framework\\Email\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-html coverage"
  }
}