{
  "name": "kodhe/framework",
  "description": "Kodhe Framework Core - Container, Config, Foundation, Exceptions & Support",
  "type": "library",
  "version": "1.1.1",
  "license": "MIT",
  "homepage": "https://github.com/karyakode/kodhe",
  "require": {
    "php": ">=8.1",
    "paragonie/random_compat": "^9.99",
    "kodhe/http": "*",
    "kodhe/agent": "*"
  },
  "suggest": {
    "kodhe/session": "Session handling",
    "kodhe/cache": "Caching",
    "kodhe/database": "Database & ORM",
    "kodhe/view": "REQUIRED for templating / app('view') / ViewFactory",
    "kodhe/validation": "Form validation",
    "kodhe/agent": "User agent library (loaded by BaseController)"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0"
  },
  "autoload": {
    "psr-4": {
      "Kodhe\\Framework\\": "src/"
    },
    "files": [
      "src/Support/Legacy/common.php",
      "src/Support/Helpers.php"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
