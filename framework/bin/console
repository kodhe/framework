#!/usr/bin/env php
<?php

/**
 * Kodhe Framework Console Entry Point
 * 
 * Usage:
 *   php console <command> [options] [arguments]
 * 
 * Examples:
 *   php console help
 *   php console list
 *   php console version
 */

declare(strict_types=1);

// Autoload
if (file_exists(__DIR__ . '/../vendor/autoload.php')) {
    require_once __DIR__ . '/../vendor/autoload.php';
} elseif (file_exists(__DIR__ . '/../../../autoload.php')) {
    require_once __DIR__ . '/../../../autoload.php';
} else {
    fwrite(STDERR, "Error: Cannot find autoload.php. Run 'composer install' first.\n");
    exit(1);
}

use Kodhe\Framework\Console\Console;
use Kodhe\Framework\Console\Input;
use Kodhe\Framework\Console\Output;

try {
    // Create console application
    $console = Console::getInstance();
    
    // Set custom name and version if needed
    $console->setName('Kodhe Framework Console');
    $console->setVersion('1.0.0');
    
    // Run the console application
    $exitCode = $console->run();
    
    exit($exitCode);
} catch (Throwable $e) {
    fwrite(STDERR, "Fatal error: {$e->getMessage()}\n");
    fwrite(STDERR, "in {$e->getFile()}:{$e->getLine()}\n");
    
    if (getenv('APP_DEBUG') === 'true' || (isset($_SERVER['argv']) && in_array('-v', $_SERVER['argv']))) {
        fwrite(STDERR, "\nStack trace:\n{$e->getTraceAsString()}\n");
    }
    
    exit(255);
}
