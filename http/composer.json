{
    "name": "kodhe/http",
    "description": "Modular HTTP component for CodeIgniter 3 with PSR-4/PSR-12 compliance",
    "type": "library",
    "version": "2.0.0",
    "license": "MIT",
    "keywords": [
        "codeigniter",
        "codeigniter3",
        "http",
        "psr-7",
        "psr-15",
        "middleware",
        "request",
        "response"
    ],
    "authors": [
        {
            "name": "CodeIgniter Community",
            "homepage": "https://codeigniter.com"
        }
    ],
    "require": {
        "php": "^7.4|^8.0",
        "psr/http-message": "^1.0|^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6|^10.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Kodhe\\Framework\\Http\\": "src/"
        },
        "files": [
            "src/helpers/url.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Kodhe\\Framework\\Http\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse src --level max",
        "cs-check": "phpcs --standard=PSR12 src tests",
        "cs-fix": "phpcbf --standard=PSR12 src tests"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "kodhe/view": "ViewFactory used by BaseController theme binding",
        "kodhe/user-agent": "Loaded optionally by BaseController"
    }
}
