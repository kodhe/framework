{
    "name": "kodhe/http",
    "description": "Modular HTTP component for Kodhe Framework with PSR-4/PSR-12 compliance",
    "type": "library",
    "license": "MIT",
    "keywords": ["kodhe", "http", "psr-7", "middleware", "codeigniter3"],
    "authors": [
        {
            "name": "Kodhe Framework Community"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7",
        "mikey179/vfsstream": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Kodhe\\Framework\\Http\\": "src/"
        },
        "files": [
            "src/helpers/url.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Kodhe\\Framework\\Http\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse src --level=7",
        "cs-check": "phpcs --standard=PSR12 src/",
        "cs-fix": "phpcbf --standard=PSR12 src/"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
