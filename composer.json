{
  "name": "kodhe/framework",
  "description": "Kodhe Framework Core - Container, Config, Foundation, Exceptions & Support",
  "type": "library",
  "version": "1.1.1",
  "license": "MIT",
  "homepage": "https://github.com/kodhe/kodhe",
  "require": {
    "php": ">=8.1",
    "paragonie/random_compat": "^9.99",
    "kodhe/session": "^1.0 || ^2.0",
    "kodhe/cache": "^1.0 || ^2.0",
    "kodhe/validation": "^1.0 || ^2.0"
  },
  "suggest": {
    "kodhe/view": "REQUIRED for templating / app('view') / ViewFactory (resolved at runtime)",
    "kodhe/auth": "Session-based authentication guard with remember-me (Kodhe\\Framework\\Auth\\Auth)"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0"
  },
  "autoload": {
    "psr-4": {
      "Kodhe\\Framework\\": "src/"
    },
    "files": [
      "src/Support/Legacy/common.php",
      "src/Support/app_path.php",
      "src/Support/Helpers.php"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
