{
  "description": "The Kodhe framework",
  "name": "karyakode/framework",
  "type": "project",
  "homepage": "https://github.com/karyakode/kodhe",
  "license": "MIT",
  "support": {
      "forum": "https://github.com/karyakode/kodhe/issues",
      "wiki": "https://github.com/karyakode/kodhe/wiki",
      "slack": "https://kodhechat.slack.com",
      "source": "https://github.com/karyakode/kodhe"
  },
  "require": {
      "php": ">=8.1",
      "paragonie/random_compat": "^9.99",
      "eftec/bladeone": "^4.19"
  },
  "suggest": {
      "paragonie/random_compat": "Provides better randomness in PHP 5.x",
      "ext-apc": "APC cache driver",
      "ext-memcached": "Memcached cache/session driver",
      "ext-redis": "Redis cache/session driver",
      "ext-openssl": "Required for encryption libraries",
      "ext-hash": "Required for encryption libraries"
  },
  "scripts": {
      "test:coverage": [
          "@putenv XDEBUG_MODE=coverage",
          "phpunit --color=always --coverage-text --configuration tests/travis/sqlite.phpunit.xml"
      ],
      "test": "phpunit --colors=always",
      "lint": "find . -name '*.php' -not -path './vendor/*' -exec php -l {} \\;",
      "post-install-cmd": [
          "sed -i s/name{0}/name[0]/ vendor/mikey179/vfsstream/src/main/php/org/bovigo/vfs/vfsStream.php"
      ],
      "post-update-cmd": [
          "sed -i s/name{0}/name[0]/ vendor/mikey179/vfsstream/src/main/php/org/bovigo/vfs/vfsStream.php"
      ]
  },
  "require-dev": {
      "mikey179/vfsstream": "1.6.*",
      "phpunit/phpunit": "^9.0|^10.0",
      "phpstan/phpstan": "^1.10",
      "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "Kodhe\\Framework\\": "framework/src/",
      "Kodhe\\Http\\Routing\\": "http/src/Routing/",
      "Kodhe\\Database\\": "database/src/",
      "Kodhe\\Http\\": "http/src/",
      "Kodhe\\Session\\": "session/src/",
      "Kodhe\\Cache\\": "cache/src/",
      "Kodhe\\Email\\": "email/src/",
      "Kodhe\\Encryption\\": "encryption/src/",
      "Kodhe\\Encrypt\\": "encrypt/src/",
      "Kodhe\\Validation\\": "validation/src/",
      "Kodhe\\Upload\\": "upload/src/",
      "Kodhe\\Image\\": "image/src/",
      "Kodhe\\Pagination\\": "pagination/src/",
      "Kodhe\\Parser\\": "parser/src/",
      "Kodhe\\Profiler\\": "profiler/src/",
      "Kodhe\\Migration\\": "migration/src/",
      "Kodhe\\Cart\\": "cart/src/",
      "Kodhe\\Calendar\\": "calendar/src/",
      "Kodhe\\Agent\\": "agent/src/",
      "Kodhe\\Ftp\\": "ftp/src/",
      "Kodhe\\Javascript\\": "javascript/src/",
      "Kodhe\\Table\\": "table/src/",
      "Kodhe\\Test\\": "test/src/",
      "Kodhe\\Trackback\\": "trackback/src/",
      "Kodhe\\Typography\\": "typography/src/",
      "Kodhe\\Xmlrpc\\": "xmlrpc/src/",
      "Kodhe\\Xmlrpcs\\": "xmlrpcs/src/",
      "Kodhe\\Zip\\": "zip/src/",
      "Kodhe\\Driver\\": "driver/src/",
      "Kodhe\\View\\": "view/src/"
    },
    "files": [
      "framework/src/Support/Legacy/common.php",
      "framework/src/Support/Helpers.php",
      "http/src/helpers/url.php",
      "http/src/helpers/routing.php",
      "cache/src/compat.php",
      "session/src/helpers.php",
      "session/src/compat.php",
      "email/src/compat.php",
      "agent/src/compat.php",
      "upload/src/compat.php",
      "view/src/helpers/template.php",
      "view/src/helpers/template_asset.php",
      "validation/src/helpers/form.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Kodhe\\Framework\\Tests\\": "framework/tests/",
      "Kodhe\\Database\\Tests\\": "database/tests/",
      "Kodhe\\Http\\Tests\\": "http/tests/",
      "Kodhe\\Encryption\\Tests\\": "encryption/tests/",
      "Kodhe\\Encrypt\\Tests\\": "encrypt/tests/",
      "Kodhe\\Test\\Tests\\": "test/tests/",
      "Kodhe\\Cache\\Tests\\": "cache/tests/",
      "Kodhe\\Parser\\Tests\\": "parser/tests/",
      "Kodhe\\Profiler\\Tests\\": "profiler/tests/",
      "Kodhe\\Driver\\Tests\\": "driver/tests/",
      "Kodhe\\Cart\\Tests\\": "cart/tests/",
      "Kodhe\\Agent\\Tests\\": "agent/tests/",
      "Kodhe\\Ftp\\Tests\\": "ftp/tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
