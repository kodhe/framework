*.pyo
*.pyd

# Node.js (if any JS files exist)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Java/Maven/Gradle (if any Java files exist)
*.class
*.jar
*.war
*.ear
target/
.gradle/
build/

